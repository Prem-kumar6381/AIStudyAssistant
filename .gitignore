[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Tt]est[Rr]esults/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.pidb
*.booproj
*.svclog

# Visual Studio / Rider / JetBrains
.vs/
.idea/
*.DotSettings.user
_ReSharper*/

# VS Code (preserve shared configuration if any)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
