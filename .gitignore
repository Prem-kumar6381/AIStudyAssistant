# --- Node / Frontend (Client) ---
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local

# --- Environment & Secret Files ---
.env
.env.*
!.env.example
!sample.env
appsettings.Production.json
appsettings.*.local.json
secrets.json

# --- OS Generated Files ---
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
