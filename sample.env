# =================================================================
# AIStudyAssistant — Production Environment Variables (Sample)
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# =================================================================

# -----------------------------------------------------------------
# Backend: ASP.NET Core (.NET 8 Web API)
# -----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080

# Database Connection: Cloud-Hosted or Local MySQL (e.g. Aiven, PlanetScale, Clever Cloud, Railway, AWS RDS)
# Format: Server=YOUR_HOST;Port=3306;Database=YOUR_DATABASE;User=YOUR_USER;Password=YOUR_PASSWORD;SslMode=Preferred;
ConnectionStrings__DefaultConnection=Server=YOUR_MYSQL_HOST;Port=3306;Database=aistudyassistant;User=YOUR_MYSQL_USER;Password=YOUR_MYSQL_PASSWORD;
Database__Provider=MySQL

# JWT Security Settings (Secret key MUST be at least 32 characters long)
Jwt__SecretKey=REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARACTERS
Jwt__Issuer=AIStudyAssistant.API
Jwt__Audience=AIStudyAssistant.Client
Jwt__ExpiryDays=7

# Google Gemini API
Gemini__ApiKey=YOUR_GEMINI_API_KEY
Gemini__Model=gemini-3.5-flash
Gemini__FallbackModel=gemini-3.5-flash-lite

# CORS Configuration (Allowed Origins separated by semicolon or array notation)
Cors__AllowedOrigins__0=https://your-frontend.pages.dev
Cors__AllowedOrigins__1=http://localhost:5173

# -----------------------------------------------------------------
# Frontend: React + Vite (Cloudflare Pages / Vercel)
# -----------------------------------------------------------------
# Base URL pointing to the deployed .NET backend API
VITE_API_BASE_URL=https://your-backend-api.onrender.com
